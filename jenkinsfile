pipeline {
agent any
environment {
REGISTRY = "localhost:5000"
IMAGE_NAME= "student-demo-app"
}
stages{
stage('1. Checkout Code'){
steps{
checkout scm
}
}
stage('2.Application Build and Test'){
steps{
echo"Verifying Python syntax..."
bat'python -m py_compile app.py'
}
}
stage('3.Build and Tag Docker image'){
steps{
echo"Building image tagged with Build #${env.BUILD.NUMBER} and latest..."
bat "docker build -t ${REGISTRTY}/ ${IMAGE_NAME}:${BUILD_NUMBER} -t
${REGISTRY}/${IMAGE_NAME):latest ."
}
}
stage('4.Push image to Registry'){
steps{
echo"Pushing versioned and latest tags to local registry..."
bat "docker push ${REGISTRTY}/ ${IMAGE_NAME}:${BUILD_NUMBER}"
bat "docker push ${REGISTRTY}/ ${IMAGE_NAME}:latest"
}
}
}
post{
success{
echo"Pipeline succeeded! Image ${REGISTRTY}/ ${IMAGE_NAME}:${BUILD_NUMBER} is availabe locally and in the registry."
}
}
}



